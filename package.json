{
	"name": "astro-cactus",
	"version": "6.5.0",
	"private": false,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"new:note": "node scripts/new-content.mjs note",
		"new:post": "node scripts/new-content.mjs post"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^6.3.11",
		"@astrojs/mdx": "^4.3.14",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/noto-sans-jp": "^5.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^5.18.2",
		"astro-expressive-code": "^0.41.7",
		"astro-icon": "^1.2.0",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.1.9",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.0",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.13.1",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.11",
		"@biomejs/biome": "^1.9.4",
		"@iconify-json/mdi": "^1.2.3",
		"@pagefind/default-ui": "^1.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/unist": "^3.0.3",
		"@types/vfile": "^3.0.2",
		"autoprefixer": "^10.6.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.1.8",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.35.0"
		},
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
